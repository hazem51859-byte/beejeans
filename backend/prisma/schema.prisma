generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(uuid())
  username               String           @unique
  email                  String           @unique
  password               String
  fullName               String
  phone                  String?
  role                   String           @default("CASHIER")
  isActive               Boolean          @default(true)
  branchId               String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  activityLogs           ActivityLog[]
  expenses               Expense[]
  auditsCreated          InventoryAudit[] @relation("AuditCreator")
  auditsSettled          InventoryAudit[] @relation("AuditSettler")
  returnsCreated         Return[]         @relation("ReturnCreator")
  returnsManagerReviewed Return[]         @relation("ReturnManagerReviewer")
  officeReturnsCreated   OfficeReturn[]   @relation("OfficeReturnCreator")
  sales                  Sale[]
  shifts                 Shift[]
  transfersReceived      Transfer[]       @relation("TransferReceivedBy")
  transfersSent          Transfer[]       @relation("TransferSentBy")
  branch                 Branch?          @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([username])
  @@map("users")
}

model Branch {
  id                 String             @id @default(uuid())
  name               String
  code               String             @unique
  url                String             @unique
  address            String?
  phone              String?
  city               String?
  isActive           Boolean            @default(true)
  vaultBalance       Float              @default(0)
  cardVaultBalance   Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  walletBalance      Float              @default(0)
  activityLogs       ActivityLog[]
  expenses           Expense[]
  inventory          Inventory[]
  audits             InventoryAudit[]
  moneyTransfersFrom MoneyTransfer[]    @relation("MoneyTransferFrom")
  moneyTransfersTo   MoneyTransfer[]    @relation("MoneyTransferTo")
  productSerials     ProductSerial[]
  purchases          Purchase[]
  returns            Return[]
  sales              Sale[]
  shifts             Shift[]
  transfersFrom      Transfer[]         @relation("TransferFrom")
  transfersTo        Transfer[]         @relation("TransferTo")
  users              User[]
  vaultTransactions  VaultTransaction[]

  @@index([code])
  @@index([url])
  @@map("branches")
}

model Category {
  id                  String     @id @default(uuid())
  name                String
  description         String?
  parentId            String?
  attributesTemplate  String?
  defaultCostPrice    Float?
  defaultSellingPrice Float?
  attributes          String?
  serialStartNumber   Int?
  lastSerialUsed      Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  parent              Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children            Category[] @relation("CategoryHierarchy")
  products            Product[]

  @@map("categories")
}

model Product {
  id                  String               @id @default(uuid())
  sku                 String               @unique
  barcode             String?              @unique
  name                String
  description         String?
  categoryId          String?
  attributes          String?
  costPrice           Float                @default(0)
  sellingPrice        Float                @default(0)
  fabricCost          Float?               @default(0)
  fabricMetersUsed    Float?               @default(0)
  manufacturingCost   Float?               @default(0)
  washingCost         Float?               @default(0)
  totalPiecesProduced Int                  @default(0)
  size                String?
  color               String?
  brand               String?
  taxRate             Float                @default(0)
  reorderLevel        Int                  @default(10)
  status              String               @default("ACTIVE")
  imageUrl            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  retailPrice         Float                @default(0)
  inventory           Inventory[]
  auditItems          InventoryAuditItem[]
  manufacturingOrders ManufacturingOrder[]
  officeInvoiceItems  OfficeInvoiceItem[]
  productSerials      ProductSerial[]
  category            Category?            @relation(fields: [categoryId], references: [id])
  purchaseItems       PurchaseItem[]
  returnItems         ReturnItem[]
  officeReturnItems   OfficeReturnItem[]
  saleItems           SaleItem[]
  transferItems       TransferItem[]

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductSerial {
  id           String    @id @default(uuid())
  productId    String
  serialNumber String
  branchId     String?
  registeredBy String
  registeredAt DateTime  @default(now())
  status       String    @default("AVAILABLE")
  soldAt       DateTime?
  soldInSaleId String?
  purchaseId   String?
  transferId   String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  branch       Branch?   @relation(fields: [branchId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])
  purchase     Purchase? @relation(fields: [purchaseId], references: [id])
  transfer     Transfer? @relation(fields: [transferId], references: [id])

  @@index([productId])
  @@index([serialNumber])
  @@index([branchId])
  @@index([status])
  @@index([purchaseId])
  @@index([transferId])
  @@map("product_serials")
}

model Inventory {
  id              String    @id @default(uuid())
  productId       String
  branchId        String
  quantity        Int       @default(0)
  minQuantity     Int       @default(10)
  lastRestockDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  branch          Branch    @relation(fields: [branchId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
  @@map("inventory")
}

model Shift {
  id                String    @id @default(uuid())
  shiftNumber       String
  userId            String
  branchId          String
  status            String    @default("OPEN")
  openingBalance    Float
  closingBalance    Float?
  expectedCash      Float?
  actualCash        Float?
  cashDifference    Float?
  totalSales        Float     @default(0)
  totalTransactions Int       @default(0)
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  notes             String?
  sales             Sale[]
  branch            Branch    @relation(fields: [branchId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@map("shifts")
}

model Sale {
  id                    String     @id @default(uuid())
  invoiceNumber         String     @unique
  branchId              String
  shiftId               String?
  cashierId             String
  customerId            String?
  customerName          String?
  customerPhone         String?
  subtotal              Float
  taxAmount             Float      @default(0)
  discountAmount        Float      @default(0)
  total                 Float
  paymentMethod         String
  amountPaid            Float
  changeAmount          Float      @default(0)
  cardConfirmed         Boolean    @default(false)
  cardAmount            Float      @default(0)
  cardDestinationBranch String?
  status                String     @default("COMPLETED")
  isReturn              Boolean    @default(false)
  originalSaleId        String?
  returnReason          String?
  refundAmount          Float      @default(0)
  notes                 String?
  syncedAt              DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  returns               Return[]
  items                 SaleItem[]
  branch                Branch     @relation(fields: [branchId], references: [id])
  cashier               User       @relation(fields: [cashierId], references: [id])
  customer              Customer?  @relation(fields: [customerId], references: [id])
  shift                 Shift?     @relation(fields: [shiftId], references: [id])

  @@index([branchId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String
  productId       String
  serialNumber    String?
  size            String?
  quantity        Int
  unitPrice       Float
  discount        Float   @default(0)
  taxRate         Float   @default(0)
  total           Float
  status          String  @default("SOLD")
  isReturned      Boolean @default(false)
  color           String?
  unitCostPrice   Float   @default(0)
  unitRetailPrice Float   @default(0)
  product         Product @relation(fields: [productId], references: [id])
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([serialNumber])
  @@map("sale_items")
}

model Partner {
  id              String               @id @default(uuid())
  name            String
  email           String?              @unique
  phone           String?
  capitalPaid     Float
  sharePercentage Float
  joinDate        DateTime             @default(now())
  isActive        Boolean              @default(true)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  transactions    PartnerTransaction[]

  @@map("partners")
}

model PartnerTransaction {
  id              String   @id @default(uuid())
  partnerId       String
  type            String
  amount          Float
  description     String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  notes           String?
  vaultType       String?  @default("CASH")
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([transactionDate])
  @@map("partner_transactions")
}

model Supplier {
  id                    String                 @id @default(uuid())
  name                  String
  phone                 String?
  email                 String?
  address               String?
  type                  String
  totalPurchases        Float                  @default(0)
  totalPaid             Float                  @default(0)
  balance               Float                  @default(0)
  notes                 String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  fabricPurchases       FabricPurchase[]
  manufacturingOrders   ManufacturingOrder[]
  miscellaneousExpenses MiscellaneousExpense[]
  purchases             Purchase[]
  payments              SupplierPayment[]
  washingOrders         WashingOrder[]

  @@index([type])
  @@map("suppliers")
}

model SupplierPayment {
  id              String    @id @default(uuid())
  supplierId      String
  purchaseId      String?
  amount          Float
  paymentMethod   String
  paymentDate     DateTime  @default(now())
  referenceNumber String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  purchase        Purchase? @relation(fields: [purchaseId], references: [id])
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

model Purchase {
  id              String            @id @default(uuid())
  invoiceNumber   String            @unique
  supplierId      String
  supplierPhone   String?
  branchId        String?
  totalAmount     Float
  paidAmount      Float             @default(0)
  remainingAmount Float             @default(0)
  paymentStatus   String            @default("PENDING")
  purchaseDate    DateTime          @default(now())
  notes           String?
  startSerial     String?
  endSerial       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  productSerials  ProductSerial[]
  items           PurchaseItem[]
  branch          Branch?           @relation(fields: [branchId], references: [id])
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  payments        SupplierPayment[]

  @@index([supplierId])
  @@index([branchId])
  @@index([invoiceNumber])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model MiscellaneousExpense {
  id              String   @id @default(uuid())
  expenseNumber   String   @unique
  supplierId      String
  description     String
  totalAmount     Float
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  paymentStatus   String   @default("PENDING")
  expenseDate     DateTime @default(now())
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  supplier        Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([expenseNumber])
  @@index([expenseDate])
  @@index([paymentStatus])
  @@map("miscellaneous_expenses")
}

model Expense {
  id            String   @id @default(uuid())
  category      String
  description   String
  amount        Float
  expenseDate   DateTime @default(now())
  branchId      String?
  receiptNumber String?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch?  @relation(fields: [branchId], references: [id])
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([branchId])
  @@index([expenseDate])
  @@map("expenses")
}

model SyncLog {
  id           String    @id @default(uuid())
  branchId     String
  entityType   String
  entityId     String
  operation    String
  data         String
  status       String    @default("PENDING")
  errorMessage String?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  syncedAt     DateTime?

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

model Transfer {
  id                String          @id @default(uuid())
  transferNumber    String          @unique
  fromBranchId      String?
  toBranchId        String
  status            String          @default("PENDING")
  notes             String?
  sentBy            String
  sentAt            DateTime        @default(now())
  receivedBy        String?
  receivedAt        DateTime?
  receiverNotes     String?
  hasDiscrepancy    Boolean         @default(false)
  discrepancyType   String?
  discrepancyNotes  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  totalCost         Float?          @default(0)
  totalSellingPrice Float?          @default(0)
  productSerials    ProductSerial[]
  items             TransferItem[]
  fromBranch        Branch?         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  receivedByUser    User?           @relation("TransferReceivedBy", fields: [receivedBy], references: [id])
  sentByUser        User            @relation("TransferSentBy", fields: [sentBy], references: [id])
  toBranch          Branch          @relation("TransferTo", fields: [toBranchId], references: [id])

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([transferNumber])
  @@map("transfers")
}

model TransferItem {
  id                String   @id @default(uuid())
  transferId        String
  productId         String
  quantityRequested Int
  quantityReceived  Int?
  status            String   @default("PENDING")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  costPrice         Float?   @default(0)
  sellingPrice      Float?   @default(0)
  retailPrice       Float?   @default(0)
  product           Product  @relation(fields: [productId], references: [id])
  transfer          Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entity      String?
  entityId    String?
  description String
  metadata    String?
  ipAddress   String?
  userAgent   String?
  branchId    String?
  createdAt   DateTime @default(now())
  branch      Branch?  @relation(fields: [branchId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([branchId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Customer {
  id             String            @id @default(uuid())
  name           String
  phone          String?           @unique
  address        String?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  walletBalance  Float             @default(0)
  payments       CustomerPayment[]
  officeInvoices OfficeInvoice[]
  officeReturns  OfficeReturn[]
  sales          Sale[]

  @@map("customers")
}

model CustomerPayment {
  id              String   @id @default(uuid())
  customerId      String
  amount          Float
  paymentMethod   String
  paymentDate     DateTime @default(now())
  referenceNumber String?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([paymentDate])
  @@map("customer_payments")
}

model Vault {
  id           String             @id @default(uuid())
  name         String             @unique
  type         String
  description  String?
  balance      Float              @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions VaultTransaction[]
  officeReturns OfficeReturn[]

  @@index([type])
  @@index([isActive])
  @@map("vaults")
}

model VaultTransaction {
  id              String   @id @default(uuid())
  branchId        String?
  type            String
  amount          Float
  saleId          String?
  invoiceNumber   String?
  shiftId         String?
  moneyTransferId String?
  description     String
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  balanceBefore   Float
  balanceAfter    Float
  vaultId         String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  vault           Vault?   @relation(fields: [vaultId], references: [id])

  @@index([vaultId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@index([saleId])
  @@index([moneyTransferId])
  @@map("vault_transactions")
}

model MoneyTransfer {
  id           String    @id @default(uuid())
  fromBranchId String
  toBranchId   String
  amount       Float
  status       String    @default("PENDING")
  sentBy       String
  sentAt       DateTime  @default(now())
  confirmedBy  String?
  confirmedAt  DateTime?
  notes        String?
  reason       String?
  fromBranch   Branch    @relation("MoneyTransferFrom", fields: [fromBranchId], references: [id])
  toBranch     Branch    @relation("MoneyTransferTo", fields: [toBranchId], references: [id])

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([sentAt])
  @@map("money_transfers")
}

model FabricType {
  id                          String                        @id @default(uuid())
  name                        String                        @unique
  pricePerMeter               Float
  description                 String?
  isActive                    Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  fabricPurchases             FabricPurchase[]
  fabricStock                 FabricStock?
  manufacturingOrderFabrics   ManufacturingOrderFabric[]
  manufacturingOrders         ManufacturingOrder[]

  @@map("fabric_types")
}

model FabricPurchase {
  id              String     @id @default(uuid())
  invoiceNumber   String     @unique
  supplierId      String
  fabricTypeId    String
  meters          Float
  pricePerMeter   Float
  totalCost       Float
  paidAmount      Float      @default(0)
  remainingAmount Float      @default(0)
  paymentStatus   String     @default("PENDING")
  purchaseDate    DateTime   @default(now())
  notes           String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  fabricType      FabricType @relation(fields: [fabricTypeId], references: [id])
  supplier        Supplier   @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([fabricTypeId])
  @@index([invoiceNumber])
  @@index([purchaseDate])
  @@map("fabric_purchases")
}

model FabricStock {
  id              String     @id @default(uuid())
  fabricTypeId    String     @unique
  availableMeters Float
  reservedMeters  Float      @default(0)
  totalPurchased  Float      @default(0)
  totalUsed       Float      @default(0)
  lastUpdated     DateTime   @updatedAt
  createdAt       DateTime   @default(now())
  fabricType      FabricType @relation(fields: [fabricTypeId], references: [id], onDelete: Cascade)

  @@map("fabric_stock")
}

model ManufacturingOrder {
  id                          String                        @id @default(uuid())
  orderNumber                 String                        @unique
  supplierId                  String
  fabricTypeId                String?
  productId                   String?
  metersUsed                  Float?
  fabricCostPerMeter          Float?
  status                      String                        @default("SENT")
  sentDate                    DateTime                      @default(now())
  sentBy                      String
  piecesReceived              Int?
  manufacturingCostPerPiece   Float?
  totalManufacturingCost      Float?
  paidAmount                  Float                         @default(0)
  remainingAmount             Float                         @default(0)
  paymentStatus               String                        @default("PENDING")
  receivedDate                DateTime?
  receivedBy                  String?
  notes                       String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  totalFabricCost             Float?
  grandTotalCost              Float?
  fabrics                     ManufacturingOrderFabric[]
  fabricType                  FabricType?                   @relation(fields: [fabricTypeId], references: [id], onDelete: Restrict)
  product                     Product?                      @relation(fields: [productId], references: [id])
  supplier                    Supplier                      @relation(fields: [supplierId], references: [id])
  washingOrders               WashingOrder[]

  @@index([supplierId])
  @@index([fabricTypeId])
  @@index([productId])
  @@index([status])
  @@index([orderNumber])
  @@map("manufacturing_orders")
}

model WashingOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique
  supplierId           String
  manufacturingOrderId String?
  piecesSent           Int
  status               String              @default("SENT")
  sentDate             DateTime            @default(now())
  sentBy               String
  piecesReceived       Int?
  washingCostPerPiece  Float?
  totalWashingCost     Float?
  paidAmount           Float               @default(0)
  remainingAmount      Float               @default(0)
  paymentStatus        String              @default("PENDING")
  receivedDate         DateTime?
  receivedBy           String?
  productId            String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  manufacturingOrder   ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([manufacturingOrderId])
  @@index([status])
  @@index([orderNumber])
  @@map("washing_orders")
}

model Return {
  id                    String       @id @default(uuid())
  returnNumber          String       @unique
  saleId                String
  branchId              String
  customerName          String?
  customerPhone         String?
  totalSaleAmount       Float
  totalCostAmount       Float
  refundMethod          String
  returnReason          String
  notes                 String?
  status                String       @default("PENDING_MANAGER")
  managerDecision       String?
  managerNotes          String?
  reviewedByManagerId   String?
  managerReviewAt       DateTime?
  returnedToInventory   Boolean      @default(false)
  returnedToInventoryAt DateTime?
  createdById           String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  items                 ReturnItem[]
  branch                Branch       @relation(fields: [branchId], references: [id])
  createdBy             User         @relation("ReturnCreator", fields: [createdById], references: [id])
  reviewedByManager     User?        @relation("ReturnManagerReviewer", fields: [reviewedByManagerId], references: [id])
  sale                  Sale         @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([branchId])
  @@index([status])
  @@index([returnNumber])
  @@index([createdById])
  @@map("returns")
}

model ReturnItem {
  id             String   @id @default(uuid())
  returnId       String
  productId      String
  quantity       Int
  size           String?
  unitSalePrice  Float
  unitCostPrice  Float
  totalSalePrice Float
  totalCostPrice Float
  returnReason   String
  condition      String   @default("GOOD")
  conditionNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id])
  return         Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

model OfficeInvoice {
  id              String              @id @default(uuid())
  invoiceNumber   String              @unique
  type            String
  customerId      String?
  customerName    String
  customerPhone   String?
  sellerId        String?
  sellerName      String?
  shipmentCompany String?
  shipmentBill    String?
  subtotal        Float
  discountAmount  Float               @default(0)
  total           Float
  totalCost       Float
  profit          Float
  paymentMethod   String
  paidAmount      Float               @default(0)
  remainingAmount Float               @default(0)
  refundAmount    Float               @default(0)
  status          String              @default("PENDING")
  notes           String?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           OfficeInvoiceItem[]
  returns         OfficeReturn[]
  customer        Customer?           @relation(fields: [customerId], references: [id])
  seller          WholesaleEmployee?  @relation(fields: [sellerId], references: [id])
  shipment        Shipment?

  @@index([type])
  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("office_invoices")
}

model OfficeInvoiceItem {
  id               String        @id @default(uuid())
  invoiceId        String
  productId        String
  quantity         Int
  returnedQuantity Int           @default(0)
  size             String?
  unitCostPrice    Float
  unitSalePrice    Float
  totalCost        Float
  totalSale        Float
  createdAt        DateTime      @default(now())
  invoice          OfficeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("office_invoice_items")
}

model OfficeReturn {
  id               String             @id @default(uuid())
  returnNumber     String             @unique
  invoiceId        String
  customerId       String?
  customerName     String
  customerPhone    String?
  totalAmount      Float
  totalCost        Float
  refundMethod     String             // VAULT_CASH, DEBT_DEDUCTION, WALLET, MIXED
  deductedFromPaid Float              @default(0)
  deductedFromDebt Float              @default(0)
  vaultId          String?
  returnReason     String?
  notes            String?
  status           String             @default("COMPLETED")
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  items            OfficeReturnItem[]
  invoice          OfficeInvoice      @relation(fields: [invoiceId], references: [id])
  vault            Vault?             @relation(fields: [vaultId], references: [id])
  customer         Customer?          @relation(fields: [customerId], references: [id])
  createdBy        User               @relation("OfficeReturnCreator", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([customerId])
  @@index([vaultId])
  @@index([returnNumber])
  @@index([createdAt])
  @@map("office_returns")
}

model OfficeReturnItem {
  id             String        @id @default(uuid())
  returnId       String
  productId      String
  invoiceItemId  String?
  quantity       Int
  size           String?
  unitSalePrice  Float
  unitCostPrice  Float
  totalSalePrice Float
  totalCostPrice Float
  returnReason   String?
  createdAt      DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id])
  officeReturn   OfficeReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
  @@map("office_return_items")
}

model Shipment {
  id                 String        @id @default(uuid())
  shipmentNumber     String        @unique
  invoiceId          String        @unique
  shipmentCompany    String
  shipmentBill       String
  customerName       String
  customerPhone      String?
  customerAddress    String?
  status             String        @default("PENDING")
  shippedAt          DateTime?
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  paymentCollected   Boolean       @default(false)
  paymentCollectedAt DateTime?
  collectedAmount    Float?
  notes              String?
  trackingNotes      String?
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  invoice            OfficeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([shipmentNumber])
  @@index([shipmentCompany])
  @@index([shippedAt])
  @@map("shipments")
}

model InventoryAudit {
  id                 String               @id @default(uuid())
  auditNumber        String               @unique
  branchId           String
  status             String               @default("IN_PROGRESS")
  totalItems         Int                  @default(0)
  itemsWithShortage  Int                  @default(0)
  itemsWithSurplus   Int                  @default(0)
  totalShortageQty   Int                  @default(0)
  totalSurplusQty    Int                  @default(0)
  totalShortageValue Float                @default(0)
  totalSurplusValue  Float                @default(0)
  createdBy          String
  settledBy          String?
  settledAt          DateTime?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  items              InventoryAuditItem[]
  branch             Branch               @relation(fields: [branchId], references: [id])
  createdByUser      User                 @relation("AuditCreator", fields: [createdBy], references: [id])
  settledByUser      User?                @relation("AuditSettler", fields: [settledBy], references: [id])

  @@index([branchId])
  @@index([status])
  @@index([auditNumber])
  @@index([createdAt])
  @@map("inventory_audits")
}

model InventoryAuditItem {
  id              String         @id @default(uuid())
  auditId         String
  productId       String
  expectedQty     Int
  returnedQty     Int            @default(0)
  actualQty       Int?
  differenceQty   Int?
  differenceType  String?
  differenceValue Float?
  unitSalePrice   Float
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  unitCostPrice   Float
  audit           InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])

  @@index([auditId])
  @@index([productId])
  @@map("inventory_audit_items")
}

model WholesaleEmployee {
  id             String          @id @default(uuid())
  name           String
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  officeInvoices OfficeInvoice[]

  @@map("wholesale_employees")
}

model ManufacturingOrderFabric {
  id                   String             @id @default(uuid())
  manufacturingOrderId String
  fabricTypeId         String
  metersUsed           Float
  fabricCostPerMeter   Float
  totalFabricCost      Float
  createdAt            DateTime           @default(now())
  fabricType           FabricType         @relation(fields: [fabricTypeId], references: [id])
  manufacturingOrder   ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)

  @@index([fabricTypeId])
  @@index([manufacturingOrderId])
  @@map("manufacturing_order_fabrics")
}
