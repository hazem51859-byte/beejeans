// Prisma Schema for Bee Jeans POS System - PostgreSQL Version

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// User Management
// =====================

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password      String
  fullName      String
  phone         String?
  role          String   @default("CASHIER") // ADMIN, MANAGER, CASHIER
  isActive      Boolean  @default(true)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  
  shifts        Shift[]
  sales         Sale[]
  expenses      Expense[]
  transfersSent     Transfer[]  @relation("TransferSentBy")
  transfersReceived Transfer[]  @relation("TransferReceivedBy")
  activityLogs      ActivityLog[]
  returnsCreated    Return[]      @relation("ReturnCreator")
  returnsManagerReviewed Return[] @relation("ReturnManagerReviewer")
  auditsCreated       InventoryAudit[]    @relation("AuditCreator")
  auditsSettled       InventoryAudit[]    @relation("AuditSettler")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([branchId])
  @@index([username])
  @@map("users")
}

// =====================
// Branch Management
// =====================

model Branch {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  url           String   @unique // URL خاص بالفرع
  address       String?
  phone         String?
  city          String?
  isActive      Boolean  @default(true)
  
  // Branch Vault (الخزينة)
  vaultBalance      Float    @default(0) // رصيد الخزينة النقدي
  cardVaultBalance  Float    @default(0) // رصيد الفيزا في الخزينة
  walletBalance     Float    @default(0) // رصيد المحفظة الإلكترونية
  
  users         User[]
  inventory     Inventory[]
  shifts        Shift[]
  sales         Sale[]
  expenses      Expense[]
  purchases     Purchase[]
  transfersFrom Transfer[]  @relation("TransferFrom")
  transfersTo   Transfer[]  @relation("TransferTo")
  activityLogs  ActivityLog[]
  productSerials ProductSerial[]
  vaultTransactions VaultTransaction[]
  moneyTransfersFrom MoneyTransfer[] @relation("MoneyTransferFrom")
  moneyTransfersTo   MoneyTransfer[] @relation("MoneyTransferTo")
  returns           Return[]
  audits            InventoryAudit[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([code])
  @@index([url])
  @@map("branches")
}

// =====================
// Product Management
// =====================

model Category {
  id            String              @id @default(uuid())
  name          String
  description   String?
  parentId      String?
  parent        Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      Category[]          @relation("CategoryHierarchy")
  
  // قالب التفاصيل (JSON string)
  // مثال: {
  //   "fields": [
  //     {"name": "المقاس", "type": "select", "options": ["S", "M", "L", "XL"], "required": true},
  //     {"name": "اللون", "type": "select", "options": ["أبيض", "أسود", "أزرق"], "required": true}
  //   ],
  //   "pricing": {
  //     "costPrice": 150,
  //     "sellingPrice": 250,
  //     "taxRate": 14
  //   }
  // }
  attributesTemplate String?
  
  defaultCostPrice    Float?
  defaultSellingPrice Float?
  attributes          String?
  
  // Serial tracking for category
  serialStartNumber   Int?      // رقم البداية للسيريالات (مثلاً 1000)
  lastSerialUsed      Int?      // آخر رقم سيريال تم استخدامه
  
  products      Product[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  sku           String        @unique // كود المنتج الثابت للباركود
  barcode       String?       @unique // الباركود (نفس الـ SKU لكل القطع من نفس النوع)
  name          String
  description   String?
  
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  
  // التفاصيل الإضافية حسب القالب (JSON string)
  // مثال: {"المقاس": "L", "اللون": "أبيض", "النوع": "جينز"}
  attributes    String?
  
  costPrice     Float         @default(0) // سعر التكلفة - يتحسب تلقائياً (قماش + تصنيع + غسيل)
  sellingPrice  Float         @default(0) // سعر البيع - قابل للتعديل
  
  // تفاصيل التكلفة (للشفافية)
  fabricCost        Float?    @default(0) // تكلفة القماش للقطعة
  fabricMetersUsed  Float?    @default(0) // إجمالي الأمتار المستخدمة لكل القطع المنتجة
  manufacturingCost Float?    @default(0) // تكلفة التصنيع للقطعة
  washingCost       Float?    @default(0) // تكلفة الغسيل للقطعة
  
  // Tracking للدورة الإنتاجية
  totalPiecesProduced Int     @default(0) // إجمالي القطع المنتجة
  
  size          String?
  color         String?
  brand         String?
  
  taxRate       Float         @default(0)
  
  reorderLevel  Int           @default(10)
  
  status        String        @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE
  
  imageUrl      String?
  
  inventory     Inventory[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  transferItems TransferItem[]
  productSerials ProductSerial[]
  manufacturingOrders ManufacturingOrder[]
  returnItems   ReturnItem[]
  officeInvoiceItems OfficeInvoiceItem[]
  auditItems    InventoryAuditItem[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// تسجيل السيريالات للمنتجات
model ProductSerial {
  id            String    @id @default(uuid())
  
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  
  serialNumber  String // السيريال (نفس الرقم لكل قطع المنتج)
  
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  
  registeredBy  String    // User ID الذي سجل السيريال
  registeredAt  DateTime  @default(now())
  
  status        String    @default("AVAILABLE") // AVAILABLE, SOLD, RETURNED, IN_TRANSIT
  
  soldAt        DateTime?
  soldInSaleId  String?   // Sale ID إذا تم بيعه
  
  // Tracking
  purchaseId    String?   // ربط بالشراء اللي جاء منه
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  
  transferId    String?   // ربط بالتوريد اللي راح فيه
  transfer      Transfer? @relation(fields: [transferId], references: [id])
  
  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([productId])
  @@index([serialNumber])
  @@index([branchId])
  @@index([status])
  @@index([purchaseId])
  @@index([transferId])
  @@map("product_serials")
}

// =====================
// Inventory Management
// =====================

model Inventory {
  id            String   @id @default(uuid())
  
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  
  quantity      Int      @default(0)
  minQuantity   Int      @default(10)
  
  lastRestockDate DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
  @@map("inventory")
}

// =====================
// Shift Management
// =====================

model Shift {
  id                String      @id @default(uuid())
  shiftNumber       String
  
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id])
  
  status            String      @default("OPEN") // OPEN, CLOSED
  
  openingBalance    Float       // Changed from Decimal to Float
  closingBalance    Float?      // Changed from Decimal to Float
  
  expectedCash      Float?      // Changed from Decimal to Float
  actualCash        Float?      // Changed from Decimal to Float
  cashDifference    Float?      // Changed from Decimal to Float
  
  totalSales        Float       @default(0) // Changed from Decimal to Float
  totalTransactions Int         @default(0)
  
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  
  notes             String?
  
  sales             Sale[]
  
  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@map("shifts")
}

// =====================
// Sales Management
// =====================

model Sale {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique
  
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])
  
  shiftId           String?
  shift             Shift?         @relation(fields: [shiftId], references: [id])
  
  cashierId         String
  cashier           User          @relation(fields: [cashierId], references: [id])
  
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  
  customerName      String?
  customerPhone     String?
  
  subtotal          Float         // Changed from Decimal to Float
  taxAmount         Float         @default(0) // Changed from Decimal to Float
  discountAmount    Float         @default(0) // Changed from Decimal to Float
  total             Float         // Changed from Decimal to Float
  
  paymentMethod     String        // CASH, CARD, CREDIT, MIXED
  amountPaid        Float         // Changed from Decimal to Float
  changeAmount      Float         @default(0) // Changed from Decimal to Float
  
  // Card payment tracking
  cardConfirmed         Boolean       @default(false) // تأكيد دفع الفيزا
  cardAmount            Float         @default(0) // المبلغ المدفوع بالفيزا
  cardDestinationBranch String?       // وجهة الفيزا: branchId أو null للمخزن الرئيسي
  
  status            String        @default("COMPLETED") // COMPLETED, PENDING, CANCELLED, REFUNDED
  
  // للإرجاعات
  isReturn          Boolean       @default(false)
  originalSaleId    String?       // رقم الفاتورة الأصلية لو كانت إرجاع
  returnReason      String?       // سبب الإرجاع
  refundAmount      Float         @default(0) // المبلغ المرتجع من هذه الفاتورة
  
  notes             String?
  
  items             SaleItem[]
  returns           Return[]
  
  syncedAt          DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([branchId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id            String   @id @default(uuid())
  
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  
  serialNumber  String?  // السيريال المستخدم في البيع
  size          String?  // المقاس المختار
  color         String?  // اللون المختار
  
  quantity      Int
  unitPrice     Float    // Changed from Decimal to Float
  discount      Float    @default(0) // Changed from Decimal to Float
  taxRate       Float    @default(0) // Changed from Decimal to Float
  total         Float    // Changed from Decimal to Float
  
  status        String   @default("SOLD") // SOLD, RETURNED
  isReturned    Boolean  @default(false) // هل تم إرجاع هذا المنتج
  
  @@index([saleId])
  @@index([productId])
  @@index([serialNumber])
  @@map("sale_items")
}

// =====================
// Partners Management
// =====================

model Partner {
  id                String              @id @default(uuid())
  name              String
  email             String?             @unique
  phone             String?
  
  capitalPaid       Float               // رأس المال المدفوع
  sharePercentage   Float               // نسبة الشراكة (%)
  
  joinDate          DateTime            @default(now())
  isActive          Boolean             @default(true)
  
  notes             String?
  
  transactions      PartnerTransaction[]
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@map("partners")
}

// Partner Transactions (معاملات الشركاء - دفعات، سحوبات، توزيع أرباح)
model PartnerTransaction {
  id                String      @id @default(uuid())
  
  partnerId         String
  partner           Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  type              String      // CAPITAL, WITHDRAWAL, PROFIT_DISTRIBUTION, LOSS_DISTRIBUTION
  amount            Float
  description       String?
  
  transactionDate   DateTime    @default(now())
  
  createdAt         DateTime    @default(now())
  
  @@index([partnerId])
  @@index([transactionDate])
  @@map("partner_transactions")
}

// =====================
// Purchases Management (المشتريات - البضاعة)
// =====================

// Suppliers (الموردين)
model Supplier {
  id              String      @id @default(uuid())
  name            String
  phone           String?
  email           String?
  address         String?
  
  // نوع المورد
  type            String      // FABRIC (قماش), MANUFACTURING (تصنيع), WASHING (غسيل)
  
  // الحسابات
  totalPurchases  Float       @default(0) // إجمالي المشتريات
  totalPaid       Float       @default(0) // إجمالي المدفوع
  balance         Float       @default(0) // الرصيد (المتبقي/الزائد)
  
  notes           String?
  isActive        Boolean     @default(true)
  
  purchases       Purchase[]
  payments        SupplierPayment[]
  fabricPurchases FabricPurchase[]
  manufacturingOrders ManufacturingOrder[]
  washingOrders   WashingOrder[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([type])
  @@map("suppliers")
}

// Supplier Payments (دفعات الموردين)
model SupplierPayment {
  id              String      @id @default(uuid())
  
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  purchaseId      String?     // ربط الدفعة بفاتورة محددة (اختياري)
  purchase        Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  
  amount          Float
  paymentMethod   String      // CASH, BANK_TRANSFER, CHECK
  paymentDate     DateTime    @default(now())
  
  referenceNumber String?     // رقم الشيك/التحويل
  notes           String?
  
  createdBy       String
  
  createdAt       DateTime    @default(now())
  
  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

model Purchase {
  id                String          @id @default(uuid())
  invoiceNumber     String          @unique
  
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  
  supplierPhone     String?
  
  branchId          String?
  branch            Branch?         @relation(fields: [branchId], references: [id])
  
  totalAmount       Float
  paidAmount        Float           @default(0)
  remainingAmount   Float           @default(0)
  
  paymentStatus     String          @default("PENDING") // PAID, PARTIAL, PENDING
  
  purchaseDate      DateTime        @default(now())
  
  notes             String?
  
  // Serial tracking for products
  startSerial       String?         // رقم السيريال الأول
  endSerial         String?         // رقم السيريال الأخير
  
  items             PurchaseItem[]
  productSerials    ProductSerial[]
  payments          SupplierPayment[] // الدفعات المرتبطة بهذه الفاتورة
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@index([supplierId])
  @@index([branchId])
  @@index([invoiceNumber])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id                String      @id @default(uuid())
  
  purchaseId        String
  purchase          Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  productId         String?
  product           Product?    @relation(fields: [productId], references: [id])
  
  productName       String
  quantity          Int
  unitPrice         Float
  total             Float
  
  createdAt         DateTime    @default(now())
  
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// =====================
// Expenses Management (المصروفات)
// =====================

model Expense {
  id                String      @id @default(uuid())
  
  category          String      // RENT, SALARY, ELECTRICITY, WATER, PURCHASES, OTHER
  description       String
  amount            Float
  
  expenseDate       DateTime    @default(now())
  
  branchId          String?
  branch            Branch?     @relation(fields: [branchId], references: [id])
  
  receiptNumber     String?
  notes             String?
  
  createdBy         String
  createdByUser     User        @relation(fields: [createdBy], references: [id])
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([category])
  @@index([branchId])
  @@index([expenseDate])
  @@map("expenses")
}

// =====================
// Sync Management
// =====================

model SyncLog {
  id            String     @id @default(uuid())
  
  branchId      String
  entityType    String     // 'sale', 'inventory', 'product', etc.
  entityId      String
  operation     String     // 'create', 'update', 'delete'
  
  data          String     // Changed from Json to String (will store JSON as string)
  
  status        String     @default("PENDING") // PENDING, SYNCED, FAILED
  errorMessage  String?
  
  attempts      Int        @default(0)
  
  createdAt     DateTime   @default(now())
  syncedAt      DateTime?
  
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

// =====================
// Transfer Management (نظام التوريدات بين الفروع)
// =====================

model Transfer {
  id                String          @id @default(uuid())
  transferNumber    String          @unique
  
  fromBranchId      String?
  fromBranch        Branch?         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  
  toBranchId        String
  toBranch          Branch          @relation("TransferTo", fields: [toBranchId], references: [id])
  
  status            String          @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, CANCELLED
  
  items             TransferItem[]
  productSerials    ProductSerial[]
  
  notes             String?
  
  // من أرسل (عادة Admin)
  sentBy            String
  sentByUser        User            @relation("TransferSentBy", fields: [sentBy], references: [id])
  sentAt            DateTime        @default(now())
  
  // من استلم (Cashier في الفرع)
  receivedBy        String?
  receivedByUser    User?           @relation("TransferReceivedBy", fields: [receivedBy], references: [id])
  receivedAt        DateTime?
  
  receiverNotes     String?         // ملاحظات المستلم
  hasDiscrepancy    Boolean         @default(false) // هل يوجد فروق؟
  discrepancyType   String?         // SHORTAGE (نقص) أو EXCESS (زيادة)
  discrepancyNotes  String?         // تفاصيل الفروقات

  totalCost         Float?          @default(0) // إجمالي تكلفة البضاعة (للأدمن)
  totalSellingPrice Float?          @default(0) // إجمالي سعر البيع للبضاعة
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([transferNumber])
  @@map("transfers")
}

model TransferItem {
  id                String      @id @default(uuid())
  
  transferId        String
  transfer          Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
  
  productId         String      // المنتج من Product Master
  product           Product     @relation(fields: [productId], references: [id])
  
  // الكميات
  quantityRequested Int         // الكمية المطلوبة
  quantityReceived  Int?        // الكمية المستلمة فعلياً

  costPrice         Float?      @default(0) // سعر التكلفة للقطعة
  sellingPrice      Float?      @default(0) // سعر البيع للقطعة
  
  // حالة العنصر
  status            String      @default("PENDING") // PENDING, DELIVERED, CANCELLED
  
  // ملاحظات
  notes             String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

// =====================
// Activity Log (تتبع نشاط المستخدمين)
// =====================

model ActivityLog {
  id              String      @id @default(uuid())
  
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  action          String      // LOGIN, LOGOUT, SHIFT_OPEN, SHIFT_CLOSE, SALE, RETURN, TRANSFER_RECEIVE, etc.
  entity          String?     // sale, product, transfer, etc.
  entityId        String?
  
  description     String      // وصف النشاط
  metadata        String?     // JSON string للبيانات الإضافية
  
  ipAddress       String?
  userAgent       String?
  
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  
  createdAt       DateTime    @default(now())
  
  @@index([userId])
  @@index([branchId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// =====================
// Customers Management (العملاء)
// =====================

model Customer {
  id              String            @id @default(uuid())
  name            String
  phone           String?           @unique
  address         String?
  notes           String?
  isActive        Boolean           @default(true)
  
  sales           Sale[]
  payments        CustomerPayment[]
  officeInvoices  OfficeInvoice[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@map("customers")
}

model CustomerPayment {
  id              String            @id @default(uuid())
  
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  amount          Float
  paymentMethod   String            // CASH, BANK_TRANSFER, CHECK
  paymentDate     DateTime          @default(now())
  
  referenceNumber String?
  notes           String?
  
  createdBy       String
  
  createdAt       DateTime          @default(now())
  
  @@index([customerId])
  @@index([paymentDate])
  @@map("customer_payments")
}

// =====================
// Vault Management (نظام الخزينة)
// =====================

model VaultTransaction {
  id                String      @id @default(uuid())
  
  branchId          String?
  branch            Branch?     @relation(fields: [branchId], references: [id])
  
  type              String      // CARD_PAYMENT, CASH_DEPOSIT, CASH_WITHDRAWAL, DRAWER_TRANSFER, OPENING_BALANCE, MONEY_TRANSFER_IN, MONEY_TRANSFER_OUT
  amount            Float
  
  // For card payments
  saleId            String?     // إذا كانت من عملية بيع بالفيزا
  invoiceNumber     String?
  
  // For drawer transfers
  shiftId           String?     // إذا كانت تحويل من/إلى الدرج
  
  // For money transfers
  moneyTransferId   String?     // إذا كانت تحويل أموال بين فروع
  
  description       String
  notes             String?
  
  createdBy         String      // User ID
  createdAt         DateTime    @default(now())
  
  balanceBefore     Float       // الرصيد قبل العملية
  balanceAfter      Float       // الرصيد بعد العملية
  
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@index([saleId])
  @@index([moneyTransferId])
  @@map("vault_transactions")
}

// =====================
// Money Transfers (تحويلات الأموال بين الفروع والمصنع)
// =====================

model MoneyTransfer {
  id                String      @id @default(uuid())
  
  fromBranchId      String
  fromBranch        Branch      @relation("MoneyTransferFrom", fields: [fromBranchId], references: [id])
  
  toBranchId        String
  toBranch          Branch      @relation("MoneyTransferTo", fields: [toBranchId], references: [id])
  
  amount            Float
  
  status            String      @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  
  // Tracking
  sentBy            String      // Manager who sent
  sentAt            DateTime    @default(now())
  
  confirmedBy       String?     // Admin/Manager who confirmed
  confirmedAt       DateTime?
  
  notes             String?
  reason            String?     // سبب التحويل
  
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([sentAt])
  @@map("money_transfers")
}

// =====================
// Fabric Management (إدارة القماش)
// =====================

// أنواع الخامات
model FabricType {
  id              String              @id @default(uuid())
  name            String              @unique // اسم الخامة (مثلاً: قطن، جينز، بوليستر)
  pricePerMeter   Float               // سعر المتر
  description     String?
  isActive        Boolean             @default(true)
  
  fabricPurchases FabricPurchase[]
  fabricStock     FabricStock[]
  manufacturingOrders ManufacturingOrder[]
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  @@map("fabric_types")
}

// مشتريات القماش من الموردين
model FabricPurchase {
  id              String      @id @default(uuid())
  invoiceNumber   String      @unique
  
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id])
  
  fabricTypeId    String
  fabricType      FabricType  @relation(fields: [fabricTypeId], references: [id])
  
  meters          Float       // عدد الأمتار المشتراة
  pricePerMeter   Float       // سعر المتر وقت الشراء
  totalCost       Float       // التكلفة الإجمالية (محسوبة تلقائياً)
  
  paidAmount      Float       @default(0)
  remainingAmount Float       @default(0)
  paymentStatus   String      @default("PENDING") // PAID, PARTIAL, PENDING
  
  purchaseDate    DateTime    @default(now())
  notes           String?
  
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([supplierId])
  @@index([fabricTypeId])
  @@index([invoiceNumber])
  @@index([purchaseDate])
  @@map("fabric_purchases")
}

// مخزن القماش
model FabricStock {
  id              String      @id @default(uuid())
  
  fabricTypeId    String
  fabricType      FabricType  @relation(fields: [fabricTypeId], references: [id])
  
  availableMeters Float       // عدد الأمتار المتاحة
  reservedMeters  Float       @default(0) // الأمتار المحجوزة للتصنيع
  
  // Tracking
  totalPurchased  Float       @default(0) // إجمالي ما تم شراؤه
  totalUsed       Float       @default(0) // إجمالي ما تم استخدامه
  
  lastUpdated     DateTime    @updatedAt
  createdAt       DateTime    @default(now())
  
  @@unique([fabricTypeId])
  @@map("fabric_stock")
}

// أوامر التصنيع (إرسال القماش للمورد للتصنيع)
model ManufacturingOrder {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  
  supplierId          String
  supplier            Supplier    @relation(fields: [supplierId], references: [id])
  
  fabricTypeId        String
  fabricType          FabricType  @relation(fields: [fabricTypeId], references: [id])
  
  // الصنف المطلوب تصنيعه
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id])
  
  metersUsed          Float       // عدد الأمتار المستخدمة
  fabricCostPerMeter  Float       // تكلفة المتر من القماش
  
  status              String      @default("SENT") // SENT, IN_PRODUCTION, COMPLETED
  
  // عند الإرسال
  sentDate            DateTime    @default(now())
  sentBy              String
  
  // عند الاستلام
  piecesReceived      Int?        // عدد القطع المستلمة
  manufacturingCostPerPiece Float? // تكلفة التصنيع للقطعة
  totalManufacturingCost    Float? // إجمالي تكلفة التصنيع
  
  paidAmount          Float       @default(0)
  remainingAmount     Float       @default(0)
  paymentStatus       String      @default("PENDING")
  
  receivedDate        DateTime?
  receivedBy          String?
  
  notes               String?
  
  washingOrders       WashingOrder[]
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  @@index([supplierId])
  @@index([fabricTypeId])
  @@index([productId])
  @@index([status])
  @@index([orderNumber])
  @@map("manufacturing_orders")
}

// أوامر الغسيل (إرسال القطع المصنعة للغسيل)
model WashingOrder {
  id                      String              @id @default(uuid())
  orderNumber             String              @unique
  
  supplierId              String
  supplier                Supplier            @relation(fields: [supplierId], references: [id])
  
  manufacturingOrderId    String?
  manufacturingOrder      ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  
  piecesSent              Int                 // عدد القطع المرسلة
  
  status                  String              @default("SENT") // SENT, IN_WASHING, COMPLETED
  
  // عند الإرسال
  sentDate                DateTime            @default(now())
  sentBy                  String
  
  // عند الاستلام
  piecesReceived          Int?                // عدد القطع المستلمة
  washingCostPerPiece     Float?              // تكلفة الغسيل للقطعة
  totalWashingCost        Float?              // إجمالي تكلفة الغسيل
  
  paidAmount              Float               @default(0)
  remainingAmount         Float               @default(0)
  paymentStatus           String              @default("PENDING")
  
  receivedDate            DateTime?
  receivedBy              String?
  
  // ربط بالمنتج النهائي
  productId               String?             // المنتج النهائي بعد اكتمال الدورة
  
  notes                   String?
  
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  
  @@index([supplierId])
  @@index([manufacturingOrderId])
  @@index([status])
  @@index([orderNumber])
  @@map("washing_orders")
}


// =====================
// Returns Management (نظام المرتجعات)
// =====================

model Return {
  id                String        @id @default(uuid())
  returnNumber      String        @unique // RET-YYYYMMDD-XXXXX
  
  // بيانات الفاتورة الأصلية
  saleId            String
  sale              Sale          @relation(fields: [saleId], references: [id])
  
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])
  
  // بيانات العميل
  customerName      String?
  customerPhone     String?
  
  // الأصناف المرتجعة
  items             ReturnItem[]
  
  // المبلغ الإجمالي (سعر البيع)
  totalSaleAmount   Float
  // المبلغ الإجمالي (سعر التكلفة)
  totalCostAmount   Float
  
  refundMethod      String        // CASH, CARD, EXCHANGE (نقدي/فيزا/استبدال)
  
  // السبب
  returnReason      String        // عيب تصنيع/مقاس غير مناسب/لون غير مناسب/أخرى
  notes             String?
  
  // حالة المرتجع
  status            String        @default("PENDING_MANAGER") 
  // PENDING_MANAGER → SENT_TO_LOCAL/SENT_TO_MAIN → COMPLETED
  
  // قرار المانجر (وجهة المرتجع)
  managerDecision   String?       // SEND_TO_LOCAL, SEND_TO_MAIN
  managerNotes      String?
  reviewedByManagerId String?
  reviewedByManager User?         @relation("ReturnManagerReviewer", fields: [reviewedByManagerId], references: [id])
  managerReviewAt   DateTime?
  
  // تم إرجاعه للمخزون
  returnedToInventory Boolean     @default(false)
  returnedToInventoryAt DateTime?
  
  // من قام بإنشاء المرتجع (الكاشير)
  createdById       String
  createdBy         User          @relation("ReturnCreator", fields: [createdById], references: [id])
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([saleId])
  @@index([branchId])
  @@index([status])
  @@index([returnNumber])
  @@index([createdById])
  @@map("returns")
}

model ReturnItem {
  id                String        @id @default(uuid())
  
  returnId          String
  return            Return        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  
  quantity          Int
  size              String?
  
  // السعر
  unitSalePrice     Float         // سعر البيع
  unitCostPrice     Float         // سعر التكلفة
  totalSalePrice    Float         // إجمالي سعر البيع
  totalCostPrice    Float         // إجمالي سعر التكلفة
  
  // سبب الإرجاع لكل منتج
  returnReason      String        // عيب تصنيع/مقاس غير مناسب/لون غير مناسب/أخرى
  
  // حالة المنتج
  condition         String        @default("GOOD") // GOOD, DAMAGED, DEFECTIVE
  conditionNotes    String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

// =====================
// Office Invoices Management (فواتير المكتب/المخزن الرئيسي)
// =====================

model OfficeInvoice {
  id                String              @id @default(uuid())
  invoiceNumber     String              @unique // OF-YYYYMMDD-XXXXX
  
  type              String              // REGULAR (زبون عادي), SHIPMENT (شحن), CLIENT (عميل)
  
  // بيانات العميل
  customerId        String?
  customer          Customer?           @relation(fields: [customerId], references: [id])
  
  customerName      String              // اسم العميل/الزبون
  customerPhone     String?             // رقم الهاتف
  
  // بيانات الشحن (إذا كان Type = SHIPMENT)
  shipmentCompany   String?             // اسم شركة الشحن
  shipmentBill      String?             // رقم بوليصة الشحن
  
  // الأصناف
  items             OfficeInvoiceItem[]
  
  // المبالغ
  subtotal          Float               // المجموع قبل الخصم
  discountAmount    Float               @default(0) // الخصم
  total             Float               // الإجمالي النهائي
  
  // التكلفة (للحسابات الداخلية)
  totalCost         Float               // إجمالي التكلفة
  profit            Float               // الربح (total - totalCost)
  
  // الدفع
  paymentMethod     String              // CASH (نقدي), CARD (فيزا), CREDIT (آجل)
  paidAmount        Float               @default(0) // المبلغ المدفوع
  remainingAmount   Float               @default(0) // المبلغ المتبقي
  
  status            String              @default("PENDING") 
  // PENDING (معلقة), COMPLETED (مكتملة), CANCELLED (ملغاة)
  // للشحن: SHIPPED (تم الشحن), DELIVERED (تم التسليم)
  
  // ربط بالشحنة إذا كان شحن
  shipment          Shipment?
  
  // ملاحظات
  notes             String?
  
  // من قام بالإنشاء (الأدمن)
  createdBy         String
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([type])
  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("office_invoices")
}

model OfficeInvoiceItem {
  id                String              @id @default(uuid())
  
  invoiceId         String
  invoice           OfficeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product             @relation(fields: [productId], references: [id])
  
  quantity          Int
  size              String?
  
  // السعر (الأدمن يحدده)
  unitCostPrice     Float               // سعر التكلفة
  unitSalePrice     Float               // سعر البيع (يحدده الأدمن)
  totalCost         Float               // إجمالي التكلفة
  totalSale         Float               // إجمالي البيع
  
  createdAt         DateTime            @default(now())
  
  @@index([invoiceId])
  @@index([productId])
  @@map("office_invoice_items")
}

// =====================
// Shipment Tracking (تتبع الشحنات)
// =====================

model Shipment {
  id                String              @id @default(uuid())
  shipmentNumber    String              @unique // SH-YYYYMMDD-XXXXX
  
  // الفاتورة المرتبطة
  invoiceId         String              @unique
  invoice           OfficeInvoice       @relation(fields: [invoiceId], references: [id])
  
  // بيانات الشحن
  shipmentCompany   String              // شركة الشحن
  shipmentBill      String              // رقم بوليصة الشحن
  
  // بيانات العميل
  customerName      String
  customerPhone     String?
  customerAddress   String?
  
  // حالة الشحن
  status            String              @default("PENDING")
  // PENDING (قيد الإنتظار), SHIPPED (تم الشحن), IN_TRANSIT (في الطريق), 
  // DELIVERED (تم التسليم), RETURNED (تم الإرجاع)
  
  // تواريخ
  shippedAt         DateTime?           // تاريخ الشحن
  estimatedDelivery DateTime?           // التاريخ المتوقع للتسليم
  deliveredAt       DateTime?           // تاريخ التسليم الفعلي
  
  // الدفع
  paymentCollected  Boolean             @default(false) // هل تم تحصيل المبلغ من شركة الشحن؟
  paymentCollectedAt DateTime?          // تاريخ التحصيل
  collectedAmount   Float?              // المبلغ المحصل
  
  // ملاحظات
  notes             String?
  trackingNotes     String?             // ملاحظات التتبع
  
  // من قام بالتحديث
  updatedBy         String?
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([status])
  @@index([shipmentNumber])
  @@index([shipmentCompany])
  @@index([shippedAt])
  @@map("shipments")
}

// =====================
// Inventory Audit (جرد المخزون)
// =====================

model InventoryAudit {
  id                String              @id @default(uuid())
  auditNumber       String              @unique // AUD-YYYYMMDD-XXXXX
  
  // الفرع اللي بيتعمله جرد
  branchId          String
  branch            Branch              @relation(fields: [branchId], references: [id])
  
  // حالة الجرد
  status            String              @default("IN_PROGRESS")
  // IN_PROGRESS (جاري الجرد), COMPLETED (اكتمل), SETTLED (تمت التسوية)
  
  // ملخص الجرد
  totalItems        Int                 @default(0) // عدد الأصناف المجردة
  itemsWithShortage Int                 @default(0) // عدد الأصناف اللي فيها عجز
  itemsWithSurplus  Int                 @default(0) // عدد الأصناف اللي فيها زيادة
  
  totalShortageQty  Int                 @default(0) // إجمالي كمية العجز
  totalSurplusQty   Int                 @default(0) // إجمالي كمية الزيادة
  totalShortageValue Float              @default(0) // قيمة العجز (بسعر البيع)
  totalSurplusValue Float               @default(0) // قيمة الزيادة (بسعر البيع)
  
  // من قام بالجرد والتسوية
  createdBy         String
  createdByUser     User                @relation("AuditCreator", fields: [createdBy], references: [id])
  
  settledBy         String?
  settledByUser     User?               @relation("AuditSettler", fields: [settledBy], references: [id])
  settledAt         DateTime?           // تاريخ التسوية
  
  // ملاحظات
  notes             String?
  
  // التواريخ
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  // العلاقات
  items             InventoryAuditItem[]
  
  @@index([branchId])
  @@index([status])
  @@index([auditNumber])
  @@index([createdAt])
  @@map("inventory_audits")
}

model InventoryAuditItem {
  id                String              @id @default(uuid())
  
  // الجرد المرتبط
  auditId           String
  audit             InventoryAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  // المنتج
  productId         String
  product           Product             @relation(fields: [productId], references: [id])
  
  // الكميات
  expectedQty       Int                 // الكمية المتوقعة (من النظام)
  returnedQty       Int                 @default(0) // كمية المرتجعات
  actualQty         Int?                // الكمية الفعلية (اللي لقيتها في الجرد)
  
  // الفرق
  differenceQty     Int?                // الفرق = actualQty - (expectedQty + returnedQty)
  differenceType    String?             // SHORTAGE (عجز), SURPLUS (زيادة), MATCHED (مطابق)
  differenceValue   Float?              // قيمة الفرق (بسعر البيع)
  
  // السعر وقت الجرد
  unitCostPrice     Float               // سعر التكلفة للقطعة (للخسارة الفعلية)
  unitSalePrice     Float               // سعر البيع للقطعة
  
  // ملاحظات
  notes             String?
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([auditId])
  @@index([productId])
  @@map("inventory_audit_items")
}
